{
  "manifest_version": 3,
  "name": "CaseLens — Unofficial USCIS Case Tracker",
  "version": "1.16.0",
  "description": "Unofficial panel showing every case on your USCIS account in one place. Nothing leaves your browser.",
  "content_scripts": [
    {
      "matches": [
        "https://my.uscis.gov/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "caselens@itsericqiu.github.io",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
